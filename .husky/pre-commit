npx lint-staged
npx tsc-files --noEmit

# Two-tier secret scan of the staged files (issue #82, ADR-0015). trufflehog has
# no staged-diff mode, so scan the working-tree content of the staged files.
# The authoritative full-history scans run at pre-push and in CI via
# `npm run security:secrets` (verified/blocking) and `security:secrets:suspected`
# (unverified/warn).
if command -v trufflehog >/dev/null 2>&1; then
  files=$(git diff --cached --name-only --diff-filter=ACM)
  if [ -n "$files" ]; then
    # Tier 1 (verified) — BLOCKING. Fails the commit on a confirmed-live secret.
    printf '%s\n' "$files" | tr '\n' '\0' \
      | xargs -0 trufflehog filesystem --results=verified --fail --no-update 2>/dev/null

    # Tier 2 (suspected) — WARN only. Surfaces unverified/unknown detector hits
    # for review without blocking the commit (no --fail; never aborts the hook).
    suspected=$(printf '%s\n' "$files" | tr '\n' '\0' \
      | xargs -0 trufflehog filesystem --results=unverified,unknown --no-update 2>/dev/null || true)
    if [ -n "$suspected" ]; then
      echo "warn: trufflehog flagged suspected (unverified) secrets in staged files —" >&2
      echo "      review below; record justified false positives in .secrets.baseline." >&2
      printf '%s\n' "$suspected" >&2
    fi
  fi
else
  echo "warn: trufflehog not installed — run scripts/bootstrap.sh" >&2
fi
