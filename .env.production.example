# Copy to .env.production and fill in real values. Never commit .env.production.
# Every variable here is required (empty values → app fails to boot, by design).

# Public URLs — where each surface is actually reachable.
APP_URL=https://console.livechat.example.com
API_URL=https://api.livechat.example.com
WIDGET_URL=https://widget.livechat.example.com

# MySQL (self-hosted compose — uses the internal `mysql` service name).
DB_NAME=livechat
DB_USER=livechat
DB_PASS=                # SECRET — generate a long random password
MYSQL_ROOT_PASSWORD=    # SECRET — different from DB_PASS

# Cryptographic secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=      # SECRET
JWT_REFRESH_SECRET=     # SECRET — must be different from JWT_ACCESS_SECRET
COOKIE_SECRET=          # SECRET — used to sign the visitor cookie

# Visitor session lifetime, enforced server-side (#79). Optional — these are the
# defaults. Absolute = hard cap from first contact; idle = max gap since the last
# request/heartbeat.
VISITOR_SESSION_ABSOLUTE_TTL_HOURS=720   # 30 days
VISITOR_SESSION_IDLE_TTL_HOURS=72        # 3 days

# SMTP — for invitation + verification + password-reset + transcript emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com

# S3-compatible storage for chat attachments. OPTIONAL — attachments are
# deferred (#80), so no deployment needs these until the feature ships. Leave
# blank. Use AWS, MinIO, DO Spaces, etc. when attachments are built.
S3_ENDPOINT=            # Leave empty for AWS S3 default
S3_REGION=us-east-1
S3_ACCESS_KEY=          # SECRET (optional until attachments ship)
S3_SECRET_KEY=          # SECRET (optional until attachments ship)
S3_BUCKET=

# Visitor data retention (see docs/privacy/data-retention.md, ADR-0011).
# Days after last activity before a visitor session is purged, and how:
# `anonymize` strips PII but keeps the row; `delete` hard-deletes it (cascades).
VISITOR_DATA_RETENTION_DAYS=90
VISITOR_DATA_RETENTION_STRATEGY=anonymize

# Logging.
LOG_LEVEL=info

# --- Jurisdiction resolution (issue #53) --------------------------------------
# Which request header carries the visitor's country / subdivision. Jurisdiction
# decides whether tracking is opt-in or opt-out, so it is read ONLY from a header
# your CDN or load balancer injects — never from the request body, which the
# embedding page controls. The edge MUST strip any client-supplied copy of these
# headers before forwarding.
#   Cloudflare        CF-IPCountry
#   Vercel            x-vercel-ip-country / x-vercel-ip-country-region
#   Google App Engine X-AppEngine-Country / X-AppEngine-Region
# Left empty, every visitor resolves to Unknown Location Mode, which is opt-in
# for presence — the fail-safe. Ambient presence tracking then never starts,
# though visitors can still chat.
GEO_COUNTRY_HEADER=
GEO_REGION_HEADER=
