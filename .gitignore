# Dependencies
node_modules
.pnp.*
.yarn/

# Build outputs
dist/
build/
out/
coverage/
.vite/
.turbo/

# Generated code (by usecase-runner) — committed per ADR-0002 so CI
# doesn't need usecase-runner to execute the Playwright suite. Never
# hand-edit; rerun `npm run usecases:generate` instead.

# Env files (commit only the example templates)
.env
.env.*
!.env.example
!.env.production.example

# Logs & caches
*.log
.cache/
.eslintcache
.stylelintcache
reports/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Test artifacts
test-results/
playwright-report/
a11y-reports/

# Security scan report artifacts (npm run security:report)
security-reports/

# TypeScript
*.tsbuildinfo

# lychee link-check cache
.lycheecache

# Downloaded by the CI security step (ci.yml "Install OSV-Scanner"). On a
# runner it is moved to /usr/local/bin; a local reproduction of that step
# leaves the 57 MB Linux binary here. Local installs go through
# scripts/bootstrap.sh instead. Root-anchored so osv-scanner.toml stays tracked.
/osv-scanner

# lhci autorun output (lhci.yml)
.lighthouseci/

# e2e stored auth state (regenerated by the setup project)
**/e2e/.auth/

# Claude Code local state (agent worktrees, scratch)
.claude/
