# Local development env for the API. Copy to `api/.env` — it is loaded
# automatically by `npm run dev` (dotenv, non-production only, see #81).
#
# The values below are working defaults for the committed `docker-compose.yml`
# stack (`docker compose up -d`), using its host-published ports. They are NOT
# secrets — do not reuse them anywhere real.

NODE_ENV=development
PORT=23001

# MySQL — docker-compose maps the container's 3306 to host 23307.
DB_HOST=127.0.0.1
DB_PORT=23307
DB_NAME=livechat_db
DB_USER=livechat_user
DB_PASS=livechat_pass

# Redis — docker-compose maps 6379 to host 26380.
REDIS_HOST=127.0.0.1
REDIS_PORT=26380

# JWT + cookie secrets. For real deployments generate with:
#   openssl rand -hex 64
JWT_ACCESS_SECRET=dev-access-secret-not-for-production
JWT_REFRESH_SECRET=dev-refresh-secret-not-for-production
COOKIE_SECRET=dev-cookie-secret-not-for-production

# URLs — the Vite dev servers and this API.
APP_URL=http://localhost:25174
API_URL=http://localhost:23001
WIDGET_URL=http://localhost:25175

# SMTP — MailHog (docker-compose maps 1025 to host 21026). Catch-all inbox at
# http://localhost:28026.
SMTP_HOST=127.0.0.1
SMTP_PORT=21026
SMTP_FROM=dev@livechat.local

# S3-compatible storage — MinIO (docker-compose maps 9000 to host 29000).
# Console at http://localhost:29001.
S3_ENDPOINT=http://127.0.0.1:29000
S3_REGION=us-east-1
# Must match docker-compose.yml's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY=livechat_minio
S3_SECRET_KEY=livechat_minio_pass
S3_BUCKET=livechat-attachments

# --- Jurisdiction resolution (issue #53) --------------------------------------
# Which request header carries the visitor's country / subdivision. Jurisdiction
# decides whether tracking is opt-in or opt-out, so it is read ONLY from a header
# your CDN or load balancer injects — never from the request body, which the
# embedding page controls. The edge MUST strip any client-supplied copy of these
# headers before forwarding.
#   Cloudflare        CF-IPCountry
#   Vercel            x-vercel-ip-country / x-vercel-ip-country-region
#   Google App Engine X-AppEngine-Country / X-AppEngine-Region
# Left empty, every visitor resolves to Unknown Location Mode, which is opt-in
# for presence — the fail-safe. Ambient presence tracking then never starts,
# though visitors can still chat.
GEO_COUNTRY_HEADER=
GEO_REGION_HEADER=
